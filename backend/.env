# Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration (SQLite default untuk development tanpa MySQL)
# DB_DRIVER=sqlite
# DB_PATH=./inventory.db

# ── MySQL via Laragon (aktifkan ini untuk hosting/production) ──
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=inflashstory

# Frontend URL untuk QR Code (Ngrok atau lokal)
FRONTEND_URL=https://unbitter-diffusely-lionel.ngrok-free.dev

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this

# Admin Default Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://unbitter-diffusely-lionel.ngrok-free.dev